SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Correos transaccionales (Fase 6, y ya usado por el formulario de Contacto) —
# Resend, permiso "Sending access" alcanza. `colombiacanta.org` ya está
# verificado en Resend (2026-09-09, registros SPF/DKIM/MX en
# send.colombiacanta.org) — en producción real, RESEND_FROM debe usar ese
# dominio y RESEND_DOMINIO_VERIFICADO debe ser "true" (ver backend/.env real).
# Para un clon nuevo del repo sin ese dominio verificado todavía, dejar los
# valores de abajo (sandbox + redirección) — ver readme_guia.md.
RESEND_API_KEY=re_your-api-key-here
# Remitente de los correos. Sin dominio verificado, debe quedar en el valor
# sandbox por defecto (no hace falta declarar esta variable). Con el dominio
# verificado, usar el remitente real:
# RESEND_FROM=Colombia Canta y Encanta <noreply@colombiacanta.org>
# A dónde llega el aviso de cada mensaje del formulario de Contacto.
CONTACTO_EMAIL_DESTINO=info@colombiacanta.org
# Solución momentánea SOLO mientras un dominio no esté verificado en Resend:
# los correos de confirmación (reserva, inscripción, pago) que deberían
# llegarle al comprador/estudiante real son RECHAZADOS por Resend (403)
# porque no es la casilla dueña de la cuenta — no se puede "agregar una
# copia" además del destinatario real, Resend rechaza la petición completa si
# cualquier destinatario no es esa casilla. Mientras tanto, esos correos se
# REDIRIGEN enteros a esta dirección (con el destinatario real anotado en el
# asunto, ej. "[Cliente: nombre@gmail.com] Tu reserva..."), para que el
# equipo avise a mano (WhatsApp).
RESEND_BCC_INTERNO=comunicaciones@colombiacanta.org
# Interruptor: "true" una vez que el dominio real esté verificado en
# resend.com/domains Y el remitente (RESEND_FROM) use ese dominio — recién
# ahí los correos llegan directo al destinatario real, sin redirigir.
RESEND_DOMINIO_VERIFICADO=false

# Mercado Pago (Fase 6, integración de pagos) — credenciales de la app en
# Developers > Tus integraciones. Usar SIEMPRE las de PRUEBA (prefijo
# TEST-) mientras se construye/prueba — nunca las de producción en un
# entorno de desarrollo.
MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key-here
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-here
# Developers > la app > Webhooks > Configurar notificaciones > revelar clave
# secreta. Valida la firma `x-signature` de cada notificación entrante (ver
# backend/src/lib/mercadoPago.js) — sin esto no se puede confiar en que un
# POST a /api/webhooks/mercadopago venga realmente de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here
# URL pública real de ESTE backend (no FRONTEND_URL) — Mercado Pago la usa
# para mandar la notificación del webhook. En desarrollo local hace falta
# un túnel público (ej. ngrok) apuntando a tu servidor local, porque
# Mercado Pago no puede alcanzar http://localhost.
BACKEND_PUBLIC_URL=https://your-backend-url.onrender.com
# Cuenta de prueba tipo "Comprador" (Developers > la app > Cuentas de
# prueba) — NO la lee el código, es solo el lugar donde este proyecto
# guarda secretos reales (ver backend/.env real). Se usa a mano: iniciar
# sesión con esto en una ventana de INCÓGNITO al probar un pago en sandbox
# — sin esto, Mercado Pago rechaza el pago porque el comprador y el
# vendedor terminan siendo la misma cuenta.
MERCADOPAGO_CUENTA_PRUEBA_COMPRADOR_USER_ID=
MERCADOPAGO_CUENTA_PRUEBA_COMPRADOR_USUARIO=
MERCADOPAGO_CUENTA_PRUEBA_COMPRADOR_PASSWORD=
MERCADOPAGO_CUENTA_PRUEBA_COMPRADOR_CODIGO_VERIFICACION=
