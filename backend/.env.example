SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Correos transaccionales (Fase 6, y ya usado por el formulario de Contacto) —
# Resend, permiso "Sending access" alcanza. Sin dominio verificado en Resend,
# los correos solo llegan a la casilla de la cuenta de Resend, no a
# destinatarios reales — ver readme_guia.md.
RESEND_API_KEY=re_your-api-key-here
# Remitente de los correos. Con RESEND_API_KEY sin dominio verificado, debe
# quedar en el valor sandbox por defecto (no hace falta declarar esta
# variable). Una vez verificado colombiacanta.org en Resend, usar algo como
# "Colombia Canta y Encanta <contacto@colombiacanta.org>".
# RESEND_FROM=Colombia Canta y Encanta <onboarding@resend.dev>
# A dónde llega el aviso de cada mensaje del formulario de Contacto.
CONTACTO_EMAIL_DESTINO=info@colombiacanta.org
